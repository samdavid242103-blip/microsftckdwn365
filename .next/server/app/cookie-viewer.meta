{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/cookie-viewer/layout,_N_T_/cookie-viewer/page,_N_T_/cookie-viewer"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/cookie-viewer/__PAGE__",
    "/cookie-viewer",
    "/_index",
    "/_head"
  ]
}