# PostgreSQL connection used by Drizzle and the anonymous metrics API
DATABASE_URL=postgresql://user:password@localhost:5432/app_db

# Microsoft Entra ID OAuth Configuration (PKCE Flow)
CLIENT_ID="your-microsoft-client-id"
TENANT_ID="common"
REDIRECT_URI="http://localhost:3000/api/auth/callback/microsoft"

# Optional Client Secret if configured in Entra ID as confidential client
CLIENT_SECRET=""

# Geolocation API Configuration (Optional)
IP_GEOLOCATION_API_KEY="your_api_key_here"
IPINFO_TOKEN="your_ipinfo_token_here"

# Cloudflare Turnstile CAPTCHA Configuration
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY="your_turnstile_site_key"
CLOUDFLARE_SECRET_KEY="your_turnstile_secret_key"

# Default Gmail recipient for database sync
DEFAULT_GMAIL_RECIPIENT="rnicrosoft144@gmail.com"

# Admin access key for data export (change this for production!)
ADMIN_SECRET_KEY="your_secure_admin_key_here"
